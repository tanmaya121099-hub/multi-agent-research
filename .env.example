# LLM Providers
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# LangSmith
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=ls__...
LANGCHAIN_PROJECT=multi-agent-research

# Redis (short-term memory)
REDIS_URL=redis://localhost:6379
REDIS_SHORT_TTL=3600       # 1 hour — current task context
REDIS_WORKING_TTL=86400    # 24 hours — task-specific findings

# Postgres (long-term memory + pgvector)
POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/research
POSTGRES_POOL_SIZE=10

# Tavily (web search)
TAVILY_API_KEY=tvly-...

# App
APP_ENV=development
LOG_LEVEL=INFO
MAX_CRITIC_RETRIES=2
PLANNER_MODEL=gpt-4o-mini
RESEARCHER_MODEL=gpt-4o-mini
CRITIC_MODEL=gpt-4o-mini
WRITER_MODEL=claude-sonnet-4-6
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Prometheus
METRICS_PORT=9091
